<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Brisk.app" type="win32" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- Starter uten forhoyede rettigheter. Programmet tilbyr selv omstart som admin. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" /><!-- Win 10 / 11 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" /><!-- Win 8.1 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" /><!-- Win 8 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" /><!-- Win 7 -->
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Med vilje IKKE DPI-bevisst.

           Manifestet lovet foer PerMonitorV2, altsa at programmet skalerer seg
           selv. Det gjorde det ikke: hver eneste plassering er hardkodede
           piksler - 212 av dem - mens fontene er oppgitt i punkter og vokser
           med DPI-en. Maalt: FSmall trenger 18,8 px pa 125 % og 22,6 px pa
           150 %, i en boks koden gir 18 px. FCard trenger 29,3 px pa 150 % i
           en boks pa 22. Teksten la seg da under linjene under, og knapper ble
           for smaa for sin egen tekst.

           Uten loftet virtualiserer Windows i stedet: alt tegnes pa 96 dpi og
           skaleres opp som et bilde. Da stemmer oppsettet pa enhver skalering.
           Prisen er at teksten blir litt mykere over 100 %. Det er en aerlig
           bytte mot et grensesnitt som ikke er til aa bruke.

           Skal dette gjores ordentlig en gang, ma alle 212 verdiene ganges med
           dpi/96 - og da ma ogsa Theme.Arrange-tilbakekallene med, siden de
           kjorer etterpa med sine egne faste tall. -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">false</dpiAware>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>

  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls"
                        version="6.0.0.0" processorArchitecture="*"
                        publicKeyToken="6595b64144ccf1df" language="*" />
    </dependentAssembly>
  </dependency>
</assembly>
